[
  {
    "method": "GET",
    "url": "/beta/networkAccess/forwardingProfiles/{uuid-1}?$expand=policies($expand=policy)"
  },
  {
    "method": "PATCH",
    "url": "/beta/networkAccess/forwardingProfiles/{uuid-1}",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "policies@delta": [
        {
          "@odata.type": "#microsoft.graph.networkaccess.forwardingPolicyLink",
          "configType": "appPolicy",
          "policy": {
            "@odata.type": "#microsoft.graph.networkaccess.forwardingPolicy",
            "id": "{uuid-2}"
          },
          "state": "enabled"
        }
      ]
    }
  }
]
